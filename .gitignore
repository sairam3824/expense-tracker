# ── Secrets ─────────────────────────────────────────────────────────────────
# Everything that could carry a key, password or session secret.
.env
.env.*
!.env.local.example
*.pem
*.key

# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases

# ── Build output ────────────────────────────────────────────────────────────
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# ── Tooling caches ──────────────────────────────────────────────────────────
.turbo/
.eslintcache
.vercel
coverage/

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS / editor cruft ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
