# Copy to .env.local for local dev, and add the same values as Environment
# Variables in Vercel. None of these are NEXT_PUBLIC_ — they must stay on the
# server, and the app is built so the browser never needs them.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Use the *service_role* key, not the anon key: the
# database is locked down with RLS and only server code is allowed through.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Login ───────────────────────────────────────────────────────────────────
# The single username that unlocks the app.
APP_USERNAME=sai

# The password is stored as a scrypt hash, never in plain text. Generate one:
#   npm run hash-password
# then paste the whole scrypt$... string here.
APP_PASSWORD_HASH=

# Signs the session cookie. Must be at least 16 characters — generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string

# ── Category suggestions (optional) ─────────────────────────────────────────
# Used to auto-pick a category from the expense description. Leave it unset and
# the app falls back to local keyword matching — everything still works.
OPENAI_API_KEY=
